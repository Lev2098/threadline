[importlinter]
root_packages =
    comments
include_external_packages = True

[importlinter:contract:layers]
name = Hexagon layers: adapters -> application -> domain
type = layers
layers =
    comments.bootstrap
    comments.adapters
    comments.application
    comments.domain

[importlinter:contract:pure-core]
name = Domain and application are framework-free
type = forbidden
source_modules =
    comments.domain
    comments.application
forbidden_modules =
    django
    rest_framework
    channels
    celery
    redis
    elasticsearch
    PIL
    strawberry
