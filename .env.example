# Copy to .env and change every "change-me" before deploying anywhere public.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Domain(s) the site is served on, comma-separated (also checked for WebSocket Origin).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to true when TLS terminates in front of nginx (Caddy, Cloudflare, load balancer).
BEHIND_TLS_PROXY=false
SECURE_COOKIES=false
LOG_LEVEL=INFO

# Public origin used in canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
SITE_URL=http://localhost:8080

# --- Auth ---
JWT_SECRET=change-me-to-another-long-random-string

# --- PostgreSQL ---
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=change-me
# Optional read replica:
# POSTGRES_REPLICA_HOST=

# --- RabbitMQ ---
RABBITMQ_USER=comments
RABBITMQ_PASSWORD=change-me

# --- Processes ---
WEB_CONCURRENCY=2
WEB_THREADS=8
REALTIME_CONCURRENCY=1
WORKER_CONCURRENCY=4
HTTP_PORT=8080

# --- Production (docker-compose.prod.yml) ---
# Uncomment both on the server: every plain `docker compose ...` command then
# uses the production overlay (HTTPS, no public app port) automatically.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Public domain pointing (A record) at the server; Caddy obtains HTTPS for it.
# DOMAIN=comments.example.com
