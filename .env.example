# Copy to .env and change every "change-me" before deploying anywhere public.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Domain(s) the site is served on, comma-separated (also checked for WebSocket Origin).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to true when TLS terminates in front of nginx (Caddy, Cloudflare, load balancer).
BEHIND_TLS_PROXY=false
SECURE_COOKIES=false
LOG_LEVEL=INFO

# --- Auth ---
JWT_SECRET=change-me-to-another-long-random-string

# --- PostgreSQL ---
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=change-me
# Optional read replica:
# POSTGRES_REPLICA_HOST=

# --- RabbitMQ ---
RABBITMQ_USER=comments
RABBITMQ_PASSWORD=change-me

# --- Processes ---
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=4
HTTP_PORT=8080
